{
  "name": "@logscopeai/logscope",
  "version": "0.0.0-development",
  "description": "Stable 1.0 Node.js SDK for sending application logs to the Logscope ingestion API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pino": {
      "types": "./dist/pino.d.ts",
      "default": "./dist/pino.js"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "default": "./dist/winston.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky install",
    "format": "prettier --config .prettierrc --write .",
    "format:check": "prettier --config .prettierrc --check .",
    "test:release": "node --test scripts/*.test.mjs",
    "release:analyze": "node scripts/analyze-release.mjs",
    "release": "semantic-release",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logscopeai/logscope.git"
  },
  "keywords": [
    "logscope",
    "logging",
    "sdk",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/logscopeai/logscope/issues"
  },
  "homepage": "https://github.com/logscopeai/logscope#readme",
  "dependencies": {
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "conventional-commits-parser": "6.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "semantic-release": "25.0.9",
    "semver": "7.7.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "winston": "^3.19.0"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx,html,css,scss,json,md}": [
      "npx prettier --config .prettierrc --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.19.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "11.19.1"
    }
  }
}
